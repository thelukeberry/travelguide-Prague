# GoCardless Bank Account Data API credentials
# Register at https://bankaccountdata.gocardless.com/ and create a token pair.
SECRET_ID=your-secret-id-here
SECRET_KEY=your-secret-key-here

# Backend
PORT=3001
DATABASE_FILE=./data/finance.db

# The URL the bank will redirect back to after Strong Customer Authentication.
# In dev this points at the Vite frontend which forwards the call to /api/connect/callback.
REDIRECT_URI=http://localhost:5173/callback

# CORS origin for the frontend dev server.
CLIENT_ORIGIN=http://localhost:5173

# Cron schedule for the background sync (default: twice per day at 07:00 and 19:00).
# Banks often rate-limit to 4 calls per account per day per endpoint, so keep this conservative.
SYNC_CRON=0 7,19 * * *

# Optional shared secret. When set, the backend requires header `x-api-token: <value>`
# on every /api/* route. Leave empty for purely local use.
API_TOKEN=

# Default country for the institutions picker (ISO 3166-1 alpha-2).
DEFAULT_COUNTRY=de
